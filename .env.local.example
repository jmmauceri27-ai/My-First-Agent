# Copy this file to .env.local (for local dev) and fill in your Supabase project's values.
# Find these in your Supabase project: Settings -> API.
# In Vercel, set the same two variables in Project Settings -> Environment Variables instead.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
