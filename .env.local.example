# Copy this file to .env.local (for local dev) and fill in your Supabase project's values.
# Find these in your Supabase project: Settings -> API.
# In Vercel, set the same variables in Project Settings -> Environment Variables instead.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Login is currently disabled (see src/proxy.ts) ---
# The app uses the service_role key server-side instead of per-request login,
# so it works without anyone signing in. NEVER prefix this with NEXT_PUBLIC_ -
# it must stay server-only, or it would be exposed to every visitor's browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The Supabase Auth user ID (Authentication -> Users -> User UID) that all
# data gets tagged with, since there's no logged-in session to read it from.
APP_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# --- Vercel Blob (Upload Data page) ---
# Large dataset uploads go browser -> Blob storage directly, bypassing Vercel's
# ~4.5MB serverless request body limit. In Vercel: Project -> Storage -> Create
# Database -> Blob. That auto-adds this env var to your project for you; you
# don't need to paste anything here manually once it's connected. Locally,
# `vercel env pull` or the Vercel dashboard can give you the value if you want
# to test uploads from your own machine.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
